{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FEX: diagnose experiment capability",
      "type": "process",
      "command": "${workspaceFolder}/Scripts/ResearchDevBuild.py",
      "args": ["doctor"],
      "problemMatcher": []
    },
    {
      "label": "FEX: initialize submodules from local caches",
      "type": "process",
      "command": "${workspaceFolder}/Scripts/ResearchDevBuild.py",
      "args": ["submodules", "--origin-cache", "--pack-cache"],
      "problemMatcher": []
    },
    {
      "label": "FEX: prepare editor lane",
      "type": "process",
      "command": "${workspaceFolder}/Scripts/ResearchDevBuild.py",
      "args": ["--lane", "editor", "editor"],
      "problemMatcher": []
    },
    {
      "label": "FEX: compile current C++ file",
      "type": "process",
      "command": "${workspaceFolder}/Scripts/ResearchDevBuild.py",
      "args": ["--lane", "editor", "compile", "${file}"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "FEX: discover configured targets and tests",
      "type": "process",
      "command": "${workspaceFolder}/Scripts/ResearchDevBuild.py",
      "args": ["--lane", "editor", "discover", "${input:fexDiscoveryQuery}"],
      "problemMatcher": []
    },
    {
      "label": "FEX: explain one target rebuild",
      "type": "process",
      "command": "${workspaceFolder}/Scripts/ResearchDevBuild.py",
      "args": ["--lane", "editor", "plan", "${input:fexTarget}"],
      "problemMatcher": []
    },
    {
      "label": "FEX: build one target",
      "type": "process",
      "command": "${workspaceFolder}/Scripts/ResearchDevBuild.py",
      "args": ["--lane", "editor", "build", "${input:fexTarget}"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "FEX: show editor lane receipt",
      "type": "process",
      "command": "${workspaceFolder}/Scripts/ResearchDevBuild.py",
      "args": ["--lane", "editor", "status"],
      "problemMatcher": []
    },
    {
      "label": "FEX: build target and run one exact CTest",
      "type": "process",
      "command": "${workspaceFolder}/Scripts/ResearchDevBuild.py",
      "args": [
        "--lane",
        "editor",
        "check",
        "${input:fexCheckTarget}",
        "${input:fexCTest}"
      ],
      "problemMatcher": ["$gcc"]
    }
  ],
  "inputs": [
    {
      "id": "fexDiscoveryQuery",
      "type": "promptString",
      "description": "Literal fragment to find in configured CMake targets and CTests",
      "default": "Vulkan"
    },
    {
      "id": "fexTarget",
      "type": "promptString",
      "description": "Exact CMake target to build (not 'everything')",
      "default": "vulkan-host-64"
    },
    {
      "id": "fexCheckTarget",
      "type": "promptString",
      "description": "Exact CMake target that owns the CTest",
      "default": "thunkgentest"
    },
    {
      "id": "fexCTest",
      "type": "promptString",
      "description": "One exact CTest name (not a regex)",
      "default": "VulkanCustomRouteInventory.ThunkGen"
    }
  ]
}
