+void ContextImpl::RetireThunkTrampolineIRHandlersInRange(
+  FEXCore::Core::InternalThreadState* Thread, uintptr_t Start, uintptr_t Length) {
+  if (Length == 0) {
+    return;
+  }
+
+  fextl::vector<uintptr_t> EntrypointsToInvalidate;
+  {
+    std::unique_lock lk(CustomIRMutex);
+    for (auto& [Entrypoint, Entry] : CustomIRHandlers) {
+      if (Entry.Creator != ThunkHandler || Entry.Data == nullptr) {
+        continue;
+      }
+
+      const auto GuestTarget = reinterpret_cast<uintptr_t>(Entry.Data);
+      const bool InRange = GuestTarget >= Start && (GuestTarget - Start) < Length;
+      if (!InRange) {
+        continue;
+      }
+
+      LogMan::Msg::DFmt("Thunks: Retiring guest trampoline from address {:#x}; target {:#x} is in retiring range {:#x}-{:#x}",
+                        Entrypoint, GuestTarget, Start, Start + Length);
+
+      // Preserve the CustomIR classification. A stale native PFN will now route to guest address zero instead of
+      // asking the frontend to decode the native PFN itself as x86. This is a diagnostic tombstone, not the final
+      // stale-call API contract.
+      Entry.Handler = [this](uintptr_t Entrypoint, FEXCore::IR::IREmitter* emit) {
+        auto IRHeader = emit->_IRHeader(emit->Invalid(), Entrypoint, 0, 0, 0, 0);
+        auto Block = emit->CreateCodeNode(true, 0);
+        IRHeader.first->Blocks = emit->WrapNode(Block);
+        emit->SetCurrentCodeBlock(Block);
+
+        const auto GPRSize = this->Config.Is64BitMode ? IR::OpSize::i64Bit : IR::OpSize::i32Bit;
+        if (GPRSize == IR::OpSize::i64Bit) {
+          IR::Ref R = emit->_StoreRegister(emit->Constant(Entrypoint), GPRSize);
+          R->Reg = IR::PhysicalRegister(IR::RegClass::GPRFixed, X86State::REG_R11).Raw;
+        } else {
+          emit->_StoreContextFPR(GPRSize, emit->_VCastFromGPR(IR::OpSize::i64Bit, IR::OpSize::i64Bit, emit->Constant(Entrypoint)),
+                                 offsetof(Core::CPUState, mm[0][0]));
+        }
+        emit->_ExitFunction(IR::OpSize::i64Bit, emit->Constant(0), IR::BranchHint::None, emit->Invalid(), emit->Invalid());
+      };
+      Entry.Data = nullptr;
+      EntrypointsToInvalidate.emplace_back(Entrypoint);
+    }
+  }
+
+  // Avoid taking the code-invalidation path while CustomIRMutex is held.
+  for (const auto Entrypoint : EntrypointsToInvalidate) {
+    SyscallHandler->InvalidateGuestCodeRange(Thread, Entrypoint, 1);
+  }
+}
+
 void ContextImpl::AddForceTSOInformation(const IntervalList<uint64_t>& ValidRanges, fextl::set<uint64_t>&& Instructions) {
   LogMan::Throw::AFmt(CodeInvalidationMutex.try_lock() == false, "CodeInvalidationMutex needs to be unique_locked here");
   ForceTSOValidRanges.Insert(ValidRanges);

